# Copy to .env.local if your API runs somewhere other than the default
NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional — PostHog analytics. Leave unset for local development: analytics
# no-op and the app runs normally (you get one console warning). Set both to
# enable event capture.
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_...
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
