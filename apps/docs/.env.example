# Analytics — cookieless PostHog, OPTIONAL and off unless set.
# With PUBLIC_POSTHOG_KEY unset the docs ship zero analytics bytes.
# Read at BUILD time by astro.config.mjs (see readEnvFile there), so a change
# here needs a rebuild + redeploy to take effect.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
